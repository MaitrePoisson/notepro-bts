{% extends 'base.html.twig' %}

{% block title %}Accueil - NotePro{% endblock %}

{% block body %}
    <div class="container">
        {% for success in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                {{ success }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-8">
                <h1 class="display-4 fw-bold mb-3">Tableau de bord</h1>
                <p class="lead text-muted">Bienvenue sur votre espace personnel de gestion scolaire.</p>
            </div>
        </div>

        <div class="row justify-content-center g-4">
            {% if is_granted('ROLE_STUDENT') %}
                <div class="col-md-6 col-lg-4">
                    <a href="{{ path('app_student_notes', {id: app.user.id}) }}" class="text-decoration-none">
                        <div class="card h-100 hover-card text-center py-5">
                            <div class="card-body">
                                <div class="display-1 mb-3">📊</div>
                                <h3 class="card-title text-dark">Mes Notes</h3>
                                <p class="card-text text-muted">Consultez vos résultats et votre moyenne.</p>
                            </div>
                        </div>
                    </a>
                </div>
            {% elseif is_granted('ROLE_PROFESSOR') %}
                <div class="col-md-6 col-lg-4">
                    <a href="{{ path('app_professor_classes', {id: app.user.id}) }}" class="text-decoration-none">
                        <div class="card h-100 hover-card text-center py-5">
                            <div class="card-body">
                                <div class="display-1 mb-3">👨‍🏫</div>
                                <h3 class="card-title text-dark">Mes Classes</h3>
                                <p class="card-text text-muted">Gérez vos classes et vos élèves.</p>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-md-6 col-lg-4">
                    <a href="{{ path('app_professor_evaluations', {id: app.user.id}) }}" class="text-decoration-none">
                        <div class="card h-100 hover-card text-center py-5">
                            <div class="card-body">
                                <div class="display-1 mb-3">📝</div>
                                <h3 class="card-title text-dark">Mes Évaluations</h3>
                                <p class="card-text text-muted">Créez des devoirs et saisissez les notes.</p>
                            </div>
                        </div>
                    </a>
                </div>
            {% else %}
                <div class="col-md-8">
                    <div class="card bg-primary text-white p-5 text-center">
                        <div class="card-body">
                            <h2>Bienvenue sur NotePro</h2>
                            <p class="mb-4">Connectez-vous pour accéder à vos espaces.</p>
                            <a href="{{ path('app_login') }}" class="btn btn-light btn-lg rounded-pill px-5 text-primary fw-bold">Se connecter</a>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
