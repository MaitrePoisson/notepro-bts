{% extends 'base.html.twig' %}

{% block title %}Accueil - NotePro{% endblock %}

{% block body %}
    {# --- Bannière Hero --- #}
    <div class="hero-banner position-relative overflow-hidden mb-5"
         style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); margin-top: -3rem; padding-top: 6rem; padding-bottom: 9rem;">

        {# Fond décoratif (Cercles) #}
        <div class="position-absolute top-0 start-0 w-100 h-100" style="opacity: 0.1;">
            <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="w-100 h-100">
                <circle cx="10" cy="10" r="20" fill="white" />
                <circle cx="90" cy="80" r="15" fill="white" />
            </svg>
        </div>

        <div class="container position-relative z-1">
            <div class="row align-items-center">
                {# Colonne Gauche : Texte & Mission #}
                <div class="col-lg-7 text-center text-lg-start mb-5 mb-lg-0">

                    {# CORRECTION ICI : Fond blanc + Texte en couleur primaire (Bleu) #}
                    <div class="mb-4 d-inline-flex align-items-center px-3 py-2 rounded-pill bg-white shadow-sm">
                        <span class="me-2">✨</span>
                        <span class="fw-bold small text-uppercase ls-1 text-primary">L'excellence scolaire simplifiée</span>
                    </div>

                    {# CORRECTION ICI : Ajout de text-white !important via style ou classe bootstrap forte #}
                    <h1 class="display-3 fw-bolder mb-4 text-white">Bienvenue sur <span class="text-warning">NotePro</span></h1>

                    <p class="lead text-white opacity-90 mb-5" style="font-size: 1.25rem; line-height: 1.8; max-width: 600px;">
                        La plateforme centralisée pour simplifier la vie scolaire.
                        Suivez vos résultats, gérez vos classes et progressez ensemble grâce à des outils intuitifs.
                    </p>

                    {% if not app.user %}
                        <div class="d-flex gap-3 justify-content-center justify-content-lg-start">
                            <a href="{{ path('app_login') }}" class="btn btn-light btn-lg rounded-pill px-5 fw-bold shadow-lg text-primary hover-scale">
                                Se connecter
                            </a>
                        </div>
                    {% endif %}
                </div>

                {# Colonne Droite : Carte Profil (Si connecté) ou Illustration #}
                <div class="col-lg-5">
                    {% if app.user %}
                        <div class="card border-0 shadow-lg rounded-4 bg-white bg-opacity-10 backdrop-blur text-white position-relative float-animation" style="border: 1px solid rgba(255,255,255,0.2);">
                            <div class="card-body p-4 p-lg-5">
                                <div class="d-flex align-items-center mb-4">
                                    <div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center shadow-sm fw-bold fs-3 me-3" style="width: 64px; height: 64px;">
                                        {{ app.user.name|slice(0, 1) }}
                                    </div>
                                    <div>
                                        <h6 class="text-uppercase opacity-75 mb-1 small ls-1 text-white">Compte Connecté</h6>
                                        <h2 class="h3 fw-bold mb-0 text-white">{{ app.user.name }}</h2>
                                    </div>
                                </div>

                                <hr class="border-white opacity-25 my-4">

                                <div class="d-grid">
                                    {% if is_granted('ROLE_STUDENT') %}
                                        <a href="{{ path('app_student_notes', {id: app.user.id}) }}" class="btn btn-warning text-dark fw-bold py-3 rounded-pill shadow-sm hover-scale">
                                            📊 Voir mes résultats
                                        </a>
                                    {% elseif is_granted('ROLE_PROFESSOR') %}
                                        <a href="{{ path('app_professor_classes', {id: app.user.id}) }}" class="btn btn-success text-white fw-bold py-3 rounded-pill shadow-sm hover-scale">
                                            👨‍🏫 Accéder à mes classes
                                        </a>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% else %}
                        {# Illustration abstraite si non connecté #}
                        <div class="position-relative text-center float-animation text-white">
                            <div class="display-1" style="font-size: 10rem;">🎓</div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Vague de transition (Rotation 180deg pour coller au bas) #}
        <div class="position-absolute bottom-0 start-0 w-100 overflow-hidden" style="line-height: 0;">
            <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none" style="width: 100%; height: 80px; fill: var(--background-color); transform: rotate(180deg);">
                <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z"></path>
            </svg>
        </div>
    </div>

    <div class="container" style="margin-top: -2rem;">
        {% for success in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
                {{ success }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        {# --- Menu de Navigation Rapide (Si connecté) --- #}
        {% if app.user %}
            <div class="row justify-content-center g-4 mb-5">
                <div class="col-12 text-center mb-2">
                    <h5 class="text-muted fw-bold text-uppercase ls-1 fs-7">Accès Rapide</h5>
                </div>

                {# Bloc Étudiant #}
                {% if is_granted('ROLE_STUDENT') %}
                    <div class="col-md-4">
                        <a href="{{ path('app_student_notes', {id: app.user.id}) }}" class="text-decoration-none card-hover-lift">
                            <div class="card h-100 border-0 shadow-sm rounded-4 p-3">
                                <div class="d-flex align-items-center">
                                    <div class="bg-indigo-subtle text-indigo p-3 rounded-circle me-3">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark mb-1">Mes Résultats</h6>
                                        <p class="text-muted small mb-0">Consulter le bulletin</p>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                {% endif %}

                {# Blocs Professeur #}
                {% if is_granted('ROLE_PROFESSOR') %}
                    <div class="col-md-4">
                        <a href="{{ path('app_professor_classes', {id: app.user.id}) }}" class="text-decoration-none card-hover-lift">
                            <div class="card h-100 border-0 shadow-sm rounded-4 p-3">
                                <div class="d-flex align-items-center">
                                    <div class="bg-success-subtle text-success p-3 rounded-circle me-3">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark mb-1">Gestion Classes</h6>
                                        <p class="text-muted small mb-0">Liste des élèves</p>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a href="{{ path('app_professor_evaluations', {id: app.user.id}) }}" class="text-decoration-none card-hover-lift">
                            <div class="card h-100 border-0 shadow-sm rounded-4 p-3">
                                <div class="d-flex align-items-center">
                                    <div class="bg-orange-subtle text-orange p-3 rounded-circle me-3">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark mb-1">Évaluations</h6>
                                        <p class="text-muted small mb-0">Saisir des notes</p>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {# --- Section Présentation (Pour tout le monde, en bas) --- #}
        <div class="text-center mb-5 mt-5">
            <h6 class="text-uppercase text-primary fw-bold ls-2">Pourquoi NotePro ?</h6>
            <h2 class="fw-bold">Une gestion simplifiée pour tous</h2>
        </div>

        <div class="row g-4 text-center mb-5">
            <div class="col-md-4">
                <div class="p-4">
                    <div class="mb-3 fs-1 p-3 bg-white rounded-circle shadow-sm d-inline-block text-primary">🚀</div>
                    <h5 class="fw-bold mt-2">Rapide & Fluide</h5>
                    <p class="text-muted">Une interface optimisée pour accéder à vos informations essentielles en un clin d'œil.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4">
                    <div class="mb-3 fs-1 p-3 bg-white rounded-circle shadow-sm d-inline-block text-success">🔒</div>
                    <h5 class="fw-bold mt-2">Données Sécurisées</h5>
                    <p class="text-muted">Vos résultats et informations personnelles sont strictement confidentiels et protégés.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4">
                    <div class="mb-3 fs-1 p-3 bg-white rounded-circle shadow-sm d-inline-block text-warning">📱</div>
                    <h5 class="fw-bold mt-2">Accessible Partout</h5>
                    <p class="text-muted">Consultez vos notes et gérez vos cours depuis votre ordinateur, tablette ou mobile.</p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
