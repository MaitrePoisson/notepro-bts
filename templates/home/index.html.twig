{% extends 'base.html.twig' %}

{% block title %}Accueil - NotePro{% endblock %}

{% block body %}
    {# Bannière Hero avec dégradé moderne #}
    <div class="position-relative w-100 mb-5 text-white overflow-hidden rounded-bottom-5"
         style="background: linear-gradient(120deg, #4e73df 0%, #224abe 100%); margin-top: -3rem; padding-top: 5rem; padding-bottom: 6rem;">

        {# Formes abstraites en fond #}
        <div class="position-absolute top-0 start-0 w-100 h-100" style="opacity: 0.1;">
            <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="w-100 h-100">
                <path d="M0 100 C 20 0 50 0 100 100 Z" fill="white" />
            </svg>
        </div>

        <div class="container position-relative z-1 text-center">
            <div class="mb-3 d-inline-block p-3 rounded-circle bg-white bg-opacity-25 text-white shadow-sm backdrop-blur">
                <span class="fs-1">🎓</span>
            </div>
            <h1 class="display-3 fw-bold mb-3">Bienvenue sur NotePro</h1>
            <p class="lead mb-4 opacity-75 mx-auto" style="max-width: 600px;">
                La plateforme de gestion scolaire conçue pour simplifier la vie des étudiants et des professeurs.
            </p>

            {% if not app.user %}
                <div class="d-flex gap-3 justify-content-center">
                    <a href="{{ path('app_login') }}" class="btn btn-light btn-lg rounded-pill px-5 fw-bold shadow-lg text-primary">
                        Connexion
                    </a>
                    <a href="{{ path('app_register') }}" class="btn btn-outline-light btn-lg rounded-pill px-5 fw-bold">
                        Créer un compte
                    </a>
                </div>
            {% else %}
                <div class="badge bg-white bg-opacity-10 border border-white border-opacity-25 px-4 py-2 rounded-pill fw-light fs-6 backdrop-blur">
                    Connecté en tant que <strong class="fw-bold">{{ app.user.name }}</strong>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="container" style="margin-top: -4rem;">
        {% for success in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
                {{ success }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        {# Grille de navigation #}
        <div class="row justify-content-center g-4">

            {% if is_granted('ROLE_STUDENT') %}
                <div class="col-md-6 col-lg-5">
                    <a href="{{ path('app_student_notes', {id: app.user.id}) }}" class="text-decoration-none card-hover-lift">
                        <div class="card h-100 border-0 shadow rounded-4 overflow-hidden">
                            <div class="card-body p-5 text-center position-relative">
                                <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-4 mb-4 text-primary">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                                </div>
                                <h3 class="h4 fw-bold text-dark mb-2">Mes Résultats</h3>
                                <p class="text-muted mb-0">Consultez vos notes, suivez votre moyenne générale et visualisez vos progrès.</p>
                                <div class="mt-4 text-primary fw-bold small text-uppercase">Accéder <span class="ms-1">→</span></div>
                            </div>
                            <div class="card-footer bg-primary py-1 border-0"></div>
                        </div>
                    </a>
                </div>

            {% elseif is_granted('ROLE_PROFESSOR') %}
                <div class="col-md-6 col-lg-4">
                    <a href="{{ path('app_professor_classes', {id: app.user.id}) }}" class="text-decoration-none card-hover-lift">
                        <div class="card h-100 border-0 shadow rounded-4">
                            <div class="card-body p-5 text-center">
                                {# Changement de couleur ici : bg-info -> bg-success et text-info -> text-success #}
                                <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex p-4 mb-4 text-success">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                                </div>
                                <h3 class="h4 fw-bold text-dark">Mes Classes</h3>
                                <p class="text-muted small mb-0">Gérez vos classes et vos élèves.</p>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-md-6 col-lg-4">
                    <a href="{{ path('app_professor_evaluations', {id: app.user.id}) }}" class="text-decoration-none card-hover-lift">
                        <div class="card h-100 border-0 shadow rounded-4">
                            <div class="card-body p-5 text-center">
                                <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex p-4 mb-4 text-warning">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                                </div>
                                <h3 class="h4 fw-bold text-dark">Évaluations</h3>
                                <p class="text-muted small mb-0">Créez et notez les devoirs.</p>
                            </div>
                        </div>
                    </a>
                </div>
            {% endif %}
        </div>

        {# Section Features (si non connecté) #}
        {% if not app.user %}
            <div class="row mt-5 pt-5 g-4">
                <div class="col-md-4 text-center">
                    <div class="mb-3 fs-1">🚀</div>
                    <h5 class="fw-bold">Rapide & Simple</h5>
                    <p class="text-muted small">Une interface épurée pour aller à l'essentiel sans perdre de temps.</p>
                </div>
                <div class="col-md-4 text-center">
                    <div class="mb-3 fs-1">🔒</div>
                    <h5 class="fw-bold">Sécurisé</h5>
                    <p class="text-muted small">Vos données sont protégées et accessibles uniquement par vous.</p>
                </div>
                <div class="col-md-4 text-center">
                    <div class="mb-3 fs-1">📱</div>
                    <h5 class="fw-bold">Mobile First</h5>
                    <p class="text-muted small">Consultez vos notes depuis votre smartphone ou votre tablette.</p>
                </div>
            </div>
        {% endif %}
    </div>

    <style>
        .backdrop-blur {
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }
        .card-hover-lift {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            display: block;
        }
        .card-hover-lift:hover {
            transform: translateY(-10px);
        }
        .card-hover-lift:hover .card {
            box-shadow: 0 1rem 3rem rgba(0,0,0,.15)!important;
        }
    </style>
{% endblock %}
