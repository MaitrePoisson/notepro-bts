{% extends 'base.html.twig' %}

{% block title %}Saisie des notes{% endblock %}

{% block body %}
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h1 class="h3 mb-1">Saisie des notes</h1>
                        <p class="text-muted mb-0">
                            {{ evaluation.label }} <span class="mx-2">•</span>
                            <span class="badge bg-primary">{{ evaluation.classLevel.label }}</span>
                        </p>
                    </div>
                    <div class="text-end">
                        <span class="fw-bold fs-5">Barème : /{{ evaluation.bareme }}</span>
                    </div>
                </div>

                <div class="card shadow-sm border-0">
                    <div class="card-header bg-light py-3">
                        <div class="row">
                            <div class="col-6 fw-bold text-uppercase fs-7 text-muted">Étudiant</div>
                            <div class="col-4 fw-bold text-uppercase fs-7 text-muted text-center">Note</div>
                            <div class="col-2 fw-bold text-uppercase fs-7 text-muted text-center">Absence</div>
                        </div>
                    </div>
                    <div class="card-body">
                        {{ form_start(form) }}
                        <div class="vstack gap-3">
                            {% for child in form %}
                                {% if 'grade_' in child.vars.name %}
                                    {% set studentId = child.vars.name|replace({'grade_': ''}) %}
                                    {% set presenceField = form['presence_' ~ studentId] %}

                                    <div class="row align-items-center border-bottom pb-2">
                                        <div class="col-6">
                                            <label class="form-label fw-medium mb-0">{{ child.vars.label }}</label>
                                        </div>
                                        <div class="col-4">
                                            {{ form_widget(child, {'attr': {'class': 'form-control text-center', 'placeholder': 'Note'}}) }}
                                        </div>
                                        <div class="col-2 text-center">
                                            <div class="form-check d-inline-block form-switch">
                                                {{ form_widget(presenceField, {'attr': {'class': 'form-check-input'}}) }}
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>

                        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                            <a href="{{ path('app_professor_evaluations', {id: app.user.id}) }}" class="btn btn-light text-muted">Annuler</a>
                            {{ form_widget(form.submit, {'attr': {'class': 'btn btn-success px-5 rounded-pill'}}) }}
                        </div>
                        {{ form_end(form, {'render_rest': false}) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
