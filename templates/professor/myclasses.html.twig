{% extends 'base.html.twig' %}

{% block title %}Mes classes - NotePro{% endblock %}

{% block body %}
    <div class="container py-4">
        {# --- En-tête --- #}
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-5 pb-3 border-bottom">
            <div class="mb-3 mb-md-0">
                <h1 class="display-5 fw-bold text-dark mb-1">Mes Classes</h1>
                <p class="text-muted fs-5 mb-0">Gestion des groupes d'élèves</p>
            </div>
            <div>
                <a href="{{ path('app_home') }}" class="btn btn-outline-secondary rounded-pill px-4">
                    ← Retour Accueil
                </a>
            </div>
        </div>

        {# --- Grille des classes --- #}
        <div class="row g-4">
            {% for classe in classes %}
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden card-hover-lift">
                        <div class="card-body p-5 text-center">
                            {# Icône Thématique #}
                            <div class="bg-success-subtle text-success rounded-circle d-inline-flex p-4 mb-4 shadow-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                            </div>

                            <h3 class="h3 fw-bold text-dark mb-2">{{ classe.label }}</h3>

                            <p class="text-muted mb-4">
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                                    <span class="fw-bold">{{ classe.students|length }}</span> élèves inscrits
                                </span>
                            </p>

                            <div class="d-grid">
                                <a href="{{ path('app_class_level_show', {id: classe.id}) }}" class="btn btn-success text-white fw-bold py-3 rounded-pill shadow-sm transition-transform hover-scale">
                                    Voir le détail
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-light text-center py-5 shadow-sm border-0 rounded-4">
                        <div class="mb-3 fs-1 text-muted" style="opacity: 0.5;">📭</div>
                        <h4 class="text-muted fw-bold">Aucune classe assignée</h4>
                        <p class="text-muted mb-0">Vous n'avez pas encore de classe pour cette année scolaire.</p>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
