{% extends 'base.html.twig' %}

{% block title %}Mes notes - NotePro{% endblock %}

{% block body %}
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-5 border-bottom pb-3">
            <div>
                <h1 class="h2 mb-0">Bulletin de notes</h1>
                <span class="text-muted">Année scolaire 2024-2025</span>
            </div>
            <div>
                <span class="h4 text-primary fw-bold">{{ student.name }}</span>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                {% for subject, grades in gradesBySubject %}
                    <div class="card mb-4 shadow-sm border-0">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                            <h5 class="mb-0 text-primary fw-bold d-flex align-items-center">
                                <span class="badge bg-primary me-3 rounded-pill" style="width: 10px; height: 10px; padding: 0;">&nbsp;</span>
                                {{ subject }}
                            </h5>
                            {% if averages[subject] is not null %}
                                <div class="d-flex flex-column align-items-end">
                                <span class="badge {{ averages[subject] >= 10 ? 'bg-success' : 'bg-danger' }} rounded-pill fs-6 px-3">
                                    {{ averages[subject] }}/20
                                </span>
                                    <small class="text-muted mt-1" style="font-size: 0.7rem;">MOYENNE</small>
                                </div>
                            {% else %}
                                <span class="badge bg-secondary rounded-pill">N/A</span>
                            {% endif %}
                        </div>

                        <div class="card-body p-0">
                            {% if advices[subject] is defined %}
                                <div class="alert alert-warning border-0 rounded-0 mb-0 d-flex align-items-center" role="alert">
                                    <div class="fs-4 me-3">💡</div>
                                    <div>
                                        <strong class="d-block text-uppercase" style="font-size: 0.8rem;">Conseil pour progresser :</strong>
                                        {{ advices[subject] }}
                                    </div>
                                </div>
                            {% endif %}

                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                    <tr>
                                        <th class="ps-4 text-uppercase text-muted fs-7 border-0" style="width: 50%">Devoir</th>
                                        <th class="text-center text-uppercase text-muted fs-7 border-0">Date</th>
                                        <th class="text-end text-uppercase text-muted fs-7 border-0">Note</th>
                                        <th class="text-end pe-4 text-uppercase text-muted fs-7 border-0">Barème</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for grade in grades %}
                                        <tr>
                                            <td class="ps-4 border-bottom-0 fw-medium">{{ grade.evaluation.label }}</td>
                                            <td class="text-center border-bottom-0 text-muted">
                                                {{ grade.evaluation.date ? grade.evaluation.date|date('d/m/Y') : '-' }}
                                            </td>
                                            <td class="text-end border-bottom-0">
                                                {% if grade.present %}
                                                    <span class="fw-bold fs-5 {{ grade.grade >= (grade.evaluation.bareme / 2) ? 'text-dark' : 'text-danger' }}">
                                                        {{ grade.grade }}
                                                    </span>
                                                {% else %}
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">ABS</span>
                                                {% endif %}
                                            </td>
                                            <td class="text-end pe-4 border-bottom-0 text-muted small">
                                                / {{ grade.evaluation.bareme }}
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="4" class="text-center py-4 text-muted fst-italic">
                                                Aucune note enregistrée.
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="text-center py-5">
                        <div class="mb-3 text-muted display-1">📭</div>
                        <h3>Aucune note disponible</h3>
                        <p class="text-muted">Vos résultats apparaîtront ici une fois publiés.</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}
