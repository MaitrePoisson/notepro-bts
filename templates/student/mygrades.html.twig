{% extends 'base.html.twig' %}

{% block title %}Mes résultats - NotePro{% endblock %}

{% block body %}
    <div class="container py-4">

        {# --- CALCULS STATISTIQUES TWIG --- #}
        {% set total = 0 %}
        {% set count = 0 %}
        {% set best_grade = 0 %}
        {% set subjects_labels = [] %}
        {% set subjects_data = [] %}

        {% for subject, avg in averages %}
            {% if avg is not null %}
                {% set total = total + avg %}
                {% set count = count + 1 %}
                {% set subjects_labels = subjects_labels|merge([subject]) %}
                {% set subjects_data = subjects_data|merge([avg]) %}
                {% if avg > best_grade %}
                    {% set best_grade = avg %}
                {% endif %}
            {% endif %}
        {% endfor %}

        {% set generalAverage = count > 0 ? (total / count)|round(2) : 0 %}

        {# --- EN-TÊTE --- #}
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-5 pb-3 border-bottom">
            <div class="mb-3 mb-md-0">
                <h1 class="display-5 fw-bold text-dark mb-1">Bulletin de notes</h1>
                <p class="text-muted fs-5 mb-0">Élève : <span class="text-indigo fw-bold">{{ student.name }}</span></p>
            </div>
            <div>
                <a href="{{ path('app_home') }}" class="btn btn-outline-secondary rounded-pill px-4">
                    ← Retour Accueil
                </a>
            </div>
        </div>

        {# --- TABLEAU DE BORD (KPI) --- #}
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="card border-0 shadow h-100 overflow-hidden text-white bg-indigo-gradient card-hover-lift">
                    <div class="card-body p-4 position-relative">
                        <div class="position-relative z-2">
                            <h6 class="text-uppercase opacity-75 mb-2 ls-1">Moyenne Générale</h6>
                            <h2 class="display-3 fw-bold mb-0">{{ generalAverage }}<span class="fs-4 opacity-50">/20</span></h2>
                        </div>
                        <div class="position-absolute top-0 end-0 opacity-25" style="transform: translate(20%, -20%); font-size: 9rem;">📊</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow h-100 bg-white card-hover-lift">
                    <div class="card-body p-4 d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="text-uppercase text-muted mb-1 fw-bold fs-7 ls-1">Meilleure Moyenne</h6>
                            <h3 class="fw-bold text-success mb-0 display-6">{{ best_grade }}<span class="fs-5 text-muted fw-normal">/20</span></h3>
                        </div>
                        <div class="bg-success-subtle text-success p-3 rounded-circle">
                            <span class="fs-2">🏆</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow h-100 bg-white card-hover-lift">
                    <div class="card-body p-4 d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="text-uppercase text-muted mb-1 fw-bold fs-7 ls-1">Matières Notées</h6>
                            <h3 class="fw-bold text-dark mb-0 display-6">{{ count }}</h3>
                        </div>
                        <div class="bg-orange-subtle text-orange p-3 rounded-circle">
                            <span class="fs-2">📚</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# --- GRAPHIQUE --- #}
        <div class="card border-0 shadow mb-5 rounded-4">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h5 class="fw-bold text-dark m-0">📈 Analyse des performances</h5>
            </div>
            <div class="card-body p-4">
                <div style="height: 350px; width: 100%;">
                    <canvas id="gradesChart"></canvas>
                </div>
            </div>
        </div>

        {# --- LISTE DES NOTES --- #}
        <h4 class="fw-bold mb-4 text-dark ps-2 border-start border-5 border-indigo">Détail par matière</h4>

        <div class="row g-4">
            {% for subject, grades in gradesBySubject %}
                <div class="col-lg-6">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden group-card">
                        {# En-tête de carte Matière #}
                        <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <div class="icon-shape bg-light text-primary rounded-3 me-3 d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 45px; height: 45px; font-size: 1.2rem;">
                                    {{ subject|slice(0, 1) }}
                                </div>
                                <h5 class="mb-0 fw-bold text-dark">{{ subject }}</h5>
                            </div>
                            {% if averages[subject] is not null %}
                                <span class="badge {{ averages[subject] >= 10 ? 'bg-success' : 'bg-danger' }} rounded-pill px-3 py-2">
                                    Moy: {{ averages[subject] }}
                                </span>
                            {% endif %}
                        </div>

                        {# Conseil personnalisé #}
                        {% if advices[subject] is defined %}
                            <div class="px-4 py-3 bg-warning-subtle text-warning-emphasis border-bottom d-flex align-items-start">
                                <span class="me-2 fs-5">💡</span>
                                <small class="fw-semibold lh-sm pt-1">{{ advices[subject] }}</small>
                            </div>
                        {% endif %}

                        {# Tableau des notes #}
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0 align-middle">
                                    <thead class="bg-light text-uppercase fs-7 text-muted">
                                    <tr>
                                        <th class="ps-4 py-3 border-0 font-weight-bold">Devoir</th>
                                        <th class="text-end py-3 border-0 pe-4 font-weight-bold">Note</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for grade in grades %}
                                        <tr>
                                            <td class="ps-4 border-bottom-0">
                                                <div class="fw-bold text-dark">{{ grade.evaluation.label }}</div>
                                                <small class="text-muted">{{ grade.evaluation.date ? grade.evaluation.date|date('d/m/Y') : '-' }}</small>
                                            </td>
                                            <td class="text-end border-bottom-0 pe-4">
                                                {% if grade.present %}
                                                    <div class="d-inline-block text-center">
                                                            <span class="d-block fw-bold fs-5 {{ grade.grade >= 10 ? 'text-dark' : 'text-danger' }}">
                                                                {{ grade.grade }}
                                                            </span>
                                                        <span class="d-block text-muted fs-7" style="margin-top: -4px;">/{{ grade.evaluation.bareme }}</span>
                                                    </div>
                                                {% else %}
                                                    <span class="badge bg-secondary-subtle text-secondary border">ABSENT</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr><td colspan="2" class="text-center text-muted py-4 fst-italic">Aucune note enregistrée.</td></tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-light text-center py-5 shadow-sm border-0 rounded-4">
                        <div class="mb-3 fs-1">📭</div>
                        <h4 class="text-muted">Aucune donnée disponible</h4>
                        <p class="text-muted mb-0">Vos résultats apparaîtront ici une fois publiés par vos professeurs.</p>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const ctx = document.getElementById('gradesChart');
            if (ctx) {
                const labels = {{ subjects_labels|json_encode|raw }};
                const data = {{ subjects_data|json_encode|raw }};
                const generalAvg = {{ generalAverage }};

                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Moyenne par matière',
                                data: data,
                                backgroundColor: 'rgba(102, 16, 242, 0.05)', // Indigo très léger
                                borderColor: '#6610f2', // Indigo
                                borderWidth: 3,
                                pointBackgroundColor: '#fff',
                                pointBorderColor: '#6610f2',
                                pointRadius: 6,
                                pointHoverRadius: 8,
                                pointHoverBorderWidth: 3,
                                fill: true,
                                tension: 0.3
                            },
                            {
                                label: 'Moyenne Générale',
                                data: Array(labels.length).fill(generalAvg),
                                borderColor: '#fd7e14', // Orange
                                borderWidth: 2,
                                borderDash: [6, 6],
                                pointRadius: 0,
                                fill: false,
                                tension: 0
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { intersect: false, mode: 'index' },
                        plugins: {
                            legend: {
                                position: 'top',
                                align: 'end',
                                labels: { usePointStyle: true, boxWidth: 10, padding: 20, font: { size: 12 } }
                            },
                            tooltip: {
                                backgroundColor: 'rgba(44, 62, 80, 0.9)',
                                padding: 12,
                                titleFont: { size: 13 },
                                bodyFont: { size: 13 },
                                displayColors: false,
                                callbacks: {
                                    label: function(context) {
                                        return context.dataset.label + ': ' + context.raw + '/20';
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                max: 20,
                                grid: { borderDash: [4, 4], color: '#f0f0f0' },
                                ticks: { padding: 10 }
                            },
                            x: {
                                grid: { display: false },
                                ticks: { padding: 10 }
                            }
                        }
                    }
                });
            }
        });
    </script>
{% endblock %}
