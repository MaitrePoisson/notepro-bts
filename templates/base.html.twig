<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}NotePro{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🎓</text></svg>">
    {% block stylesheets %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
        <link rel="stylesheet" href="{{ asset('css/global.css') }}">
    {% endblock %}

    {% block javascripts %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous" defer></script>
    {% endblock %}
</head>
<body>
<nav class="navbar navbar-expand-lg sticky-top">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center" href="{{ path('app_home') }}">
            <span class="me-2">🎓</span> NotePro
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse justify-content-end" id="navbarNavDropdown">
            <ul class="navbar-nav align-items-center">
                {% if is_granted('ROLE_STUDENT') %}
                    <li class="nav-item mx-2">
                        <a class="nav-link fw-bold" href="{{ path('app_student_notes', {id: app.user.id}) }}">Mes notes</a>
                    </li>
                {% elseif is_granted('ROLE_PROFESSOR') %}
                    <li class="nav-item mx-2">
                        <a class="nav-link fw-bold" href="{{ path('app_professor_classes', {id: app.user.id}) }}">Mes classes</a>
                    </li>
                    <li class="nav-item mx-2">
                        <a class="nav-link fw-bold" href="{{ path('app_professor_evaluations', {id: app.user.id}) }}">Mes évaluations</a>
                    </li>
                {% endif %}

                {% if app.user %}
                    <li class="nav-item dropdown ms-3">
                        <a class="nav-link dropdown-toggle btn btn-light text-dark px-3 rounded-pill" href="#" role="button" data-bs-toggle="dropdown">
                            {{ app.user.name }}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                            <li><h6 class="dropdown-header">Compte</h6></li>
                            <li><a class="dropdown-item" href="{{ path('user_change_password') }}">Changer mot de passe</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}">Déconnexion</a></li>
                        </ul>
                    </li>
                {% else %}
                    <li class="nav-item ms-3">
                        <a class="btn btn-primary px-4 rounded-pill" href="{{ path('app_login') }}">Connexion</a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>

<main class="py-5">
    {% block body %}{% endblock %}
</main>

<footer>
    <div class="container text-center">
        <p class="mb-0 text-muted">&copy; {{ 'now'|date('Y') }} NotePro - Gestion scolaire simplifiée.</p>
    </div>
</footer>
</body>
</html>
