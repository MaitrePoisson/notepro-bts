{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="container">
        <div class="row justify-content-center align-items-center" style="min-height: 70vh;">
            <div class="col-md-5">
                <div class="card shadow-lg border-0 rounded-lg">
                    <div class="card-header justify-content-center text-center bg-transparent border-0 mt-3">
                        <h3 class="font-weight-light my-2">Bienvenue sur NotePro</h3>
                    </div>
                    <div class="card-body p-5">
                        <form action="{{ path('app_login') }}" method="post">
                            {% if error %}
                                <div class="alert alert-danger rounded-3" role="alert">
                                    {{ error.messageKey|trans(error.messageData, 'security') }}
                                </div>
                            {% endif %}

                            <div class="form-floating mb-3">
                                <input type="text" value="{{ last_username }}" name="_username" id="username" class="form-control" placeholder="name@example.com" autocomplete="email" required autofocus>
                                <label for="username">Adresse Email</label>
                            </div>

                            <div class="form-floating mb-3">
                                <input type="password" name="_password" id="password" class="form-control" placeholder="Password" autocomplete="current-password" required>
                                <label for="password">Mot de passe</label>
                            </div>

                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            <div class="d-grid gap-2 mt-4">
                                <button class="btn btn-primary btn-lg rounded-pill" type="submit">Se connecter</button>
                            </div>
                        </form>
                    </div>
                    <div class="card-footer text-center py-3 bg-transparent border-0">
                        <div class="small"><a href="{{ path('app_forgot_password_request') }}" class="text-decoration-none">Mot de passe oublié ?</a></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
